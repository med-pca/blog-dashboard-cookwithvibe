PORT=3001
NODE_ENV=development

# ── Veritabanı ──────────────────────────────────────────────
# Docker compose'da DB_HOST=db olarak override edilir
DB_HOST=localhost
DB_PORT=5432
DB_USER=renel
DB_PASS=guclu_bir_sifre_yaz

DB_NAME=renel_enerji

# Şema migration'larla kurulur ve güncellenir; uygulama açılışında bekleyen
# migration'lar otomatik çalışır (migrationsRun). Elle çalıştırmak için:
#   npm run migration:run

# ── JWT ─────────────────────────────────────────────────────
# ZORUNLU — en az 32 karakter rastgele string
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Admin ───────────────────────────────────────────────────
ADMIN_USERNAME=admin

# ZORUNLU — bcrypt hash, plain text şifre ASLA kullanılmaz
# Hash üretmek için: node -e "require('bcrypt').hash('SIFREN',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# ── CORS ────────────────────────────────────────────────────
# ZORUNLU — frontend domain (wildcard * kabul edilmez)
FRONTEND_URL=http://localhost:5173
# Opsiyonel — virgüllü açık origin listesi; doluysa aynen kullanılır (www
# türetme yapılmaz), boşsa FRONTEND_URL'den www'lu varyant türetilir.
# Örnek: CORS_ORIGINS=https://www.pulserecipe.com,https://pulserecipe.com
CORS_ORIGINS=

# ── Redis ───────────────────────────────────────────────────
# ZORUNLU — en az 32 karakter rastgele string
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_PASS=
# Docker compose'da redis://:${REDIS_PASS}@redis:6379 olarak override edilir
REDIS_URL=redis://:REDIS_PASS_BURAYA@localhost:6379

# ── Umami Analitik ──────────────────────────────────────────
# Umami kurulduktan sonra panel'den alınır
UMAMI_WEBSITE_ID=
# Umami admin şifresi (ilk girişte değiştir)
UMAMI_USER=admin
UMAMI_PASS=guclu_umami_sifresi
# Umami PostgreSQL şifresi
UMAMI_DB_PASS=guclu_umami_db_sifresi
# Umami uygulama gizli anahtarı — rastgele string
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UMAMI_APP_SECRET=

# ── Frontend Build ──────────────────────────────────────────
# Prodüksiyonda domain (örn: https://pulserecipe.com)
# Aynı domain'den servis ediliyorsa boş bırakılabilir
VITE_API_URL=
# Umami script URL'si (örn: https://umami.pulserecipe.com)
VITE_UMAMI_URL=

# ── OpenWeather ─────────────────────────────────────────────
# Dashboard hava durumu widget'ı için (opsiyonel)
OPENWEATHER_API_KEY=

# ── Instagram Graph API ─────────────────────────────────────
# Meta Developer Console → Uygulamanız → Instagram → Temel Ekran
INSTAGRAM_USER_ID=
# Meta Developer Console → Araçlar → Graph API Explorer → Token oluştur (60 gün, yenilenmesi gerekir)
INSTAGRAM_ACCESS_TOKEN=
# Meta Developer Console → Uygulamanız → Ayarlar → Temel → Uygulama gizli anahtarı
INSTAGRAM_APP_SECRET=
# Webhook aboneliği sırasında Meta'ya gönderilecek doğrulama tokeni — kendin belirle
# Üretmek için: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ── AI sağlayıcısı (chatbot + proje auto-fill) ──────────────
# Chatbot ve admin panelindeki "Auto-fill with AI" butonu bu katmanı kullanır.
# Varsayılan sağlayıcı OpenAI'dir; anahtar üretimi:
#   https://platform.openai.com/api-keys → "Create new secret key"
# Anahtar ASLA git'e girmez, ASLA frontend'e gönderilmez, ASLA log'a yazılmaz.
# VITE_ önekli bir değişkene KOYULMAZ (Vite onu bundle'a gömer, herkes görür).
#
# AKTİF SAĞLAYICI ARTIK ADMIN PANELİNDEN SEÇİLİR (/rnl-panel/ai-ayarlar).
# Seçim app_settings tablosunda saklanır; aşağıdaki AI_PROVIDER yalnızca henüz
# hiçbir seçim yapılmamışken kullanılan başlangıç değeridir.
# Joi kuralı: en az bir sağlayıcı anahtarı tanımlı olmalı (hangisi olduğu fark
# etmez). Panelde seçilen sağlayıcının anahtarı yoksa çalışma anında OpenAI'ye
# düşülür ve uyarı loglanır.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Tek çağrı için zaman aşımı (ms)
OPENAI_TIMEOUT_MS=120000
# Geçici hatalarda (429/5xx/timeout) ilk denemeden SONRAKİ deneme sayısı
OPENAI_MAX_RETRIES=3
# Chatbot'un günlük toplam istek üst sınırı (devre kesici; boşsa 1000).
# Aşılırsa chatbot sabit mesaja düşer, proje auto-fill etkilenmez.
AI_DAILY_LIMIT=1000

# ── Alternatif sağlayıcılar (OpenAI uyumlu /chat/completions) ─
# Anahtarı tanımlı olan sağlayıcı admin panelinde seçilebilir hale gelir.
# *_BASE_URL ve *_MODEL yalnızca src/ai/providers/registry.ts içindeki
# doğrulanmış varsayılanı ezmek içindir; normalde BOŞ bırakın.
#
# Aşağıdaki değerler 2026-09-12'de gerçek API'lere karşı test edilmiştir.

# Google Gemini — Bearer ile çalışır, strict json_schema destekler.
# Not: gemini-2.5-* yeni hesaplara kapalı; /models listesi onları yine de
# gösterir, yani liste kullanılabilirlik kanıtı değildir.
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

# Qwen — Alibaba Model Studio, ULUSLARARASI uç nokta.
# Anakara ucu (dashscope.aliyuncs.com) uluslararası anahtarı 401 ile reddeder.
#
# ⚠️ NODE_OPTIONS=--dns-result-order=ipv4first GEREKLİDİR.
#    Alibaba'nın AAAA kayıtları bazı ağlarda bağlanmada asılı kalır; Node o
#    zaman anlamlı bir hata vermeden timeout'a kadar bekler. Bu bayrak olmadan
#    Qwen testte çalışıp canlıda sessizce donabilir.
#
# Tek anahtarla 165 model: Qwen + DeepSeek (deepseek-v4-flash-0731,
# deepseek-v4-pro-0813) + Kimi + GLM. DeepSeek'e ayrıca bakiye yüklemeden
# DeepSeek modeli çalıştırmak için buradan geçilebilir.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# DeepSeek (doğrudan) — ÖN ÖDEMELİ. Bakiye sıfırken anahtar geçerli görünür
# ama her çağrı 402 döner. Gerçek model id'leri: deepseek-flash,
# deepseek-v4-pro ("deepseek-chat" bu hesapta yoktur).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# OpenAI uç noktasını taşımak için (proxy/Azure); normalde boş.
OPENAI_BASE_URL=

# ── Groq (ESKİ — yalnızca geri dönüş yolu) ──────────────────
# Migrasyon doğrulanana kadar tutulur. AI_PROVIDER=groq yapılmadıkça HİÇ okunmaz.
# OpenAI canlıda doğrulandıktan sonra bu blok, src/groq/ ve src/ai/providers/
# groq.provider.ts birlikte silinecek.
GROQ_CHAT_KEYS=
GROQ_PARSE_KEYS=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# AI_DAILY_LIMIT'in eski adı; yenisi tanımlı değilse hâlâ okunur.
GROQ_DAILY_LIMIT=1000

# ── Sentry (Hata İzleme) ────────────────────────────────────
# sentry.io üzerinde proje oluşturduktan sonra DSN'i buraya yapıştır
# Boş bırakılırsa Sentry devre dışı kalır
SENTRY_DSN=
APP_ENCRYPTION_KEY=  # openssl rand -hex 32 ile uret — TOTP secret sifrelemesi icin zorunlu

# ── AI blog üretimi (kampanyalar) ───────────────────────────
# Yukarıdaki OPENAI_API_KEY / OPENAI_MODEL değişkenlerini paylaşır; ayrı kuyruk
# ve ayrı zamanlayıcı kullanır. Kapalıyken backend normal açılır.
#
# 'true' yapılırsa OPENAI_API_KEY zorunlu olur (app.module.ts Joi kuralı).
AI_CONTENT_ENABLED=false
# Bir kampanyanın yerel günde üretebileceği mutlak üst sınır (kampanya
# dailyTarget'ı bunun üstüne çıkamaz)
AI_DAILY_MAX_PER_CAMPAIGN=100
# BullMQ worker eşzamanlılığı. 1'de kalmalı: üretimler güne yayılır, patlamaz.
AI_WORKER_CONCURRENCY=1
# Yeni kampanya formunun varsayılan aralığı (dakika)
AI_DEFAULT_INTERVAL_MINUTES=20
# Geçici hatalarda (429/5xx/timeout) toplam deneme sayısı
AI_MAX_ATTEMPTS=3
# Tek OpenAI çağrısı için zaman aşımı (ms)
AI_REQUEST_TIMEOUT_MS=120000
AI_IMAGE_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_SIZE=1536x1024
AI_IMAGE_QUALITY=medium
# Opsiyonel: maliyet tahmini için 1M token başına USD. Boşsa modelin
# yerleşik fiyatı kullanılır (gpt-5-nano: 0.05 giriş / 0.40 çıkış).
AI_COST_INPUT_PER_MTOK=
AI_COST_OUTPUT_PER_MTOK=
