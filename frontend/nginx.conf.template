map $http_user_agent $is_bot {
    default                       0;
    "~*googlebot"                 1;
    "~*bingbot"                   1;
    "~*yandexbot"                 1;
    "~*duckduckbot"               1;
    "~*baiduspider"               1;
    "~*facebookexternalhit"       1;
    "~*twitterbot"                1;
    "~*linkedinbot"               1;
    "~*slackbot"                  1;
    "~*whatsapp"                  1;
    "~*telegrambot"               1;
    "~*discordbot"                1;
    "~*Prerender"                 0;
}

# Rate-limit prerender rendering per client IP — bots get limited,
# normal visitors (empty key) are exempt. Prevents spoofed-UA clients
# from exhausting the prerender container's CPU/memory.
map $is_bot $prerender_limit_key {
    0 "";
    1 $binary_remote_addr;
}
limit_req_zone $prerender_limit_key zone=prerender:1m rate=1r/s;

# Restore real client IP from Cloudflare
#
# BAKIM NOTU: Asagidaki CF IP araliklari (bu geo blogu + server icindeki
# set_real_ip_from listesi) elle gomulu. Yilda bir kez
# https://www.cloudflare.com/ips/ ile karsilastir; degisiklik varsa IKI blogu
# birlikte guncelle (son kontrol: 2026-07).
geo $cloudflare {
    default 0;
    103.21.244.0/22 1; 103.22.200.0/22 1; 103.31.4.0/22 1;
    104.16.0.0/13 1;  104.24.0.0/14 1;
    108.162.192.0/18 1; 131.0.72.0/22 1; 141.101.64.0/18 1;
    162.158.0.0/15 1; 172.64.0.0/13 1;  173.245.48.0/20 1;
    188.114.96.0/20 1; 190.93.240.0/20 1; 197.234.240.0/22 1;
    198.41.128.0/17 1;
    2400:cb00::/32 1; 2606:4700::/32 1; 2803:f800::/32 1;
    2405:b500::/32 1; 2405:8100::/32 1; 2a06:98c0::/29 1;
    2c0f:f248::/32 1;
}

server {
    listen 8080;
    server_name _;

    # Yukaridaki geo $cloudflare blogu ile ayni liste — birlikte guncellenmeli
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;

    # proxy_pass with variables ($request_uri in the prerender target)
    # resolves the upstream hostname at request time, which requires a
    # resolver — use Docker's embedded DNS
    resolver 127.0.0.11 valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # TLS terminates at Cloudflare; nginx listens on plain 8080, so an
    # absolute redirect would leak "http://host:8080/..." to clients.
    absolute_redirect off;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
    gzip_comp_level 6;

    # Single source of truth for security headers — see step 3 in the pentest
    # fix plan for why every location that sets its own add_header needs this
    # repeated (nginx does not inherit add_header into a location that has one).
    include /etc/nginx/snippets/security-headers.conf;

    location ^~ /umami/ {
        # bkz. /api/ uzerindeki not (ayni DNS onbellek tuzagi) — burada ayrica
        # /umami/ onekini soyup umami'ye kok olarak iletmek icin rewrite+break
        # sart: degiskenli proxy_pass otomatik onek degistirmeyi devre disi
        # birakiyor, rewrite ile $uri'yi elle guncelleyip onu iletiyoruz.
        set $umami_upstream http://umami:3000;
        rewrite ^/umami/(.*)$ /$1 break;
        proxy_pass $umami_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect / /umami/;
        # Upstream Next.js sets its own CSP — drop it so ours (below) is the only one
        proxy_hide_header Content-Security-Policy;

        # Can't use the shared snippet here — its CSP conflicts with the relaxed
        # one below (nginx stacks repeated add_header of the same name rather
        # than overriding it), so all 7 headers stay inline for this location.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        # Relaxed CSP for Umami — Next.js requires unsafe-inline and unsafe-eval
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;
    }

    # Umami Next.js static assets — requested at /_next/ without /umami/ prefix
    location ^~ /_next/ {
        set $umami_next_upstream http://umami:3000;
        proxy_pass $umami_next_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Suppress favicon/manifest 404s that Umami's HTML triggers
    location = /favicon.ico { return 204; access_log off; }
    location = /favicon-32x32.png { return 204; access_log off; }
    location = /favicon-16x16.png { return 204; access_log off; }
    location = /site.webmanifest { return 204; access_log off; }

    # Headers helmet sets on the backend (backend/src/configure-app.ts) that
    # would otherwise duplicate ours below — nginx is the single source of truth.
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Cross-Origin-Opener-Policy;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;

    location ^~ /sitemap.xml {
        # backend'i degiskenle cozup resolver'a birakiyoruz: proxy_pass literal
        # hostname kullanirsa nginx bunu worker baslangicinda bir kere cozup
        # onbellekliyor — backend container'i tek basina yeniden olusturulunca
        # (deploy sadece backend'i etkilerse) IP degisir ama nginx eskisini
        # kullanmaya devam eder ve "Failed to fetch" verir (ayni sinif hata,
        # prerender proxy'si icin yukarida zaten cozulmustu).
        set $backend_sitemap http://backend:3001;
        proxy_pass $backend_sitemap;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # A location with its own proxy_hide_header stops inheriting the
        # server-level list entirely, so it's repeated here in full, plus
        # Cache-Control (the controller also sets it — same value, one copy wins).
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=3600";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ^~ /ads.txt {
        # Google AdSense verification file, generated from the publisher id saved
        # in the admin panel. Same variable-based proxy_pass note as /sitemap.xml.
        # Returns 404 while no publisher or additional content is configured, which is what "no
        # ads.txt" means to Google (an empty file would block ads instead).
        set $backend_adstxt http://backend:3001;
        proxy_pass $backend_adstxt;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ^~ /api/ {
        # bkz. /sitemap.xml uzerindeki not — ayni DNS onbellek hatasindan kacinmak icin degisken kullanilir
        set $backend_api http://backend:3001;
        proxy_pass $backend_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        client_max_body_size 100m;
    }

    location ^~ /uploads/ {
        set $backend_uploads http://backend:3001;
        proxy_pass $backend_uploads;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ~* \.(js|css|woff2|woff|ttf|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ~* \.(jpg|jpeg|png|gif|webp)$ {
        expires 30d;
        add_header Cache-Control "public";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ~* \.mp4$ {
        expires 30d;
        add_header Cache-Control "public";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        limit_req zone=prerender burst=20 nodelay;
        limit_req_status 429;
        if ($is_bot = 1) {
            proxy_pass http://prerender:3000/${PRERENDER_ORIGIN}$request_uri;
            break;
        }
        # Do not try $uri/ here: SPA routes such as /about collide with the
        # real /about/ asset directory and nginx redirects the route into a
        # directory listing that is forbidden. Real static files still match
        # $uri; every other request belongs to React Router.
        try_files $uri /index.html;
    }
}
